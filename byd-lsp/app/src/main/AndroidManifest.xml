<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 控制台 App 本身只负责配置与查看日志；签到请求由微信进程内的模块代码发出 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- App 侧闹钟：开机后要重排定时点 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      精确闹钟：setExactAndAllowWhileIdle 是「在 Doze 里也能按时唤醒、并临时放行联网」
      的唯一手段。Android 13 默认授予；Android 14+ 需要在系统设置里手动允许
      （设置页有入口）。没有它也不会失效 —— 会自动退化成 setAndAllowWhileIdle，
      同样能在 Doze 中触发，只是可能晚十几分钟。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 11+ 包可见性：取码前要把微信切到前台，需要能查询它的启动 Intent -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- ================= Xposed / LSPosed 元数据 ================= -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="比亚迪自动签到：进程内分析wxDEX读取真实类直取海洋小程序code并直接签到！" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- 作用域：微信。系统分身/多开包名相同，勾选一项即可覆盖 -->
        <meta-data
            android:name="xposedscope"
            android:value="com.tencent.mm" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 接收微信进程内模块回写的状态与日志（显式广播，无需 root） -->
        <receiver
            android:name=".ui.StateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="xiaojw.byd.action.STATE" />
                <action android:name="xiaojw.byd.action.LOG" />
                <action android:name="xiaojw.byd.action.LOGSNAP" />
                <action android:name="xiaojw.byd.action.REQ_CONFIG" />
                <action android:name="xiaojw.byd.action.VERSION_TABLE" />
                <action android:name="xiaojw.byd.action.PROBE" />
                <action android:name="xiaojw.byd.action.PONG" />
                <action android:name="xiaojw.byd.action.SELFTEST" />
                <action android:name="xiaojw.byd.action.TRYCODE" />
                <action android:name="xiaojw.byd.action.MODULECFG" />
                <action android:name="xiaojw.byd.action.CLAIMRESULT" />
                <action android:name="xiaojw.byd.action.CODE" />
            </intent-filter>
        </receiver>

        <!--
          App 侧闹钟的落点：到点唤醒 App 进程，由 App 发出两次 HTTPS。

          exported=false：闹钟通过显式 PendingIntent 送达（系统代本应用投递），
          不需要、也不应该对其它应用开放。
        -->
        <receiver
            android:name=".ui.AppSignReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
